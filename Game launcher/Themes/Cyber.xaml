<!--
    Thema 2 „Cyber“: modern mit Cyberpunk-Anklang, aber nicht übertrieben.
    Tiefes Blauschwarz mit weichem Neonschein (Akzentfarbe + Cyan), feine leuchtende Kanten, leicht schräge Knöpfe und Chips,
    Überschriften in „Chakra Petch“ (Fonts\, SIL Open Font License), Fließtext bleibt Segoe UI.

    Wird beim Start eingelesen (MainWindow.Theme.cs) und ersetzt gleichnamige Einträge aus MainWindow.xaml.
    Platzhalter: __ACCENT__ (#RRGGBB), __ACCENT40__ / __ACCENT22__ (Akzent mit Deckkraft), __INK__ (Schrift auf Akzent).
    Wo es geht, wird {DynamicResource AccentBrush} benutzt, damit auch der RGB-Modus mitläuft.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Farben ========== -->
    <Color x:Key="NeonCyan">#22D3EE</Color>
    <SolidColorBrush x:Key="CyanBrush" Color="#22D3EE"/>

    <!-- Hintergrund: Blauschwarz mit zwei weichen Lichtflecken (oben links Akzent, unten rechts Cyan), kein Muster -->
    <DrawingBrush x:Key="AppBackgroundBrush" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,1600,1000">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#06080D">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1600,1000"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="__ACCENT22__" Offset="0"/>
                            <GradientStop Color="#0006080D" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="180,60" RadiusX="900" RadiusY="620"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush>
                            <GradientStop Color="#1A22D3EE" Offset="0"/>
                            <GradientStop Color="#0006080D" Offset="1"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1480,980" RadiusX="900" RadiusY="640"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="SidebarBrush" Color="#0A0D14"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E121B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E2638"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121726"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8F0F8"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3B1C6"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#66758C"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#3C4659"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#D9111622"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1A2133"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#263049"/>
    <LinearGradientBrush x:Key="CardFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EB10151F" Offset="0"/>
        <GradientStop Color="#EB0B0F17" Offset="1"/>
    </LinearGradientBrush>
    <!-- Feine Neonkante: oben links Akzent, unten rechts Cyan -->
    <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="__ACCENT40__" Offset="0"/>
        <GradientStop Color="#22303F5A" Offset="0.4"/>
        <GradientStop Color="#22303F5A" Offset="0.7"/>
        <GradientStop Color="#4422D3EE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#33FFFFFF"/>
    <LinearGradientBrush x:Key="ButtonSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InkBrush" Color="__INK__"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#E8F0F8"/>

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <!-- Weiches Neonleuchten (heißt aus Kompatibilitätsgründen weiter „HardShadow“) -->
    <DropShadowEffect x:Key="HardShadow" BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="__ACCENT__"/>
    <DropShadowEffect x:Key="NeonGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.7" Color="__ACCENT__"/>
    <DropShadowEffect x:Key="CyanGlow" BlurRadius="16" ShadowDepth="0" Opacity="0.65" Color="#22D3EE"/>
    <DropShadowEffect x:Key="TitleGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="__ACCENT__"/>

    <!-- ========== Texte ========== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Effect" Value="{StaticResource TitleGlow}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#22D3EE"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ========== Karten ========== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="#141A28"/>
        <Setter Property="BorderBrush" Value="#5522D3EE"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
    </Style>

    <!-- ========== Knöpfe: leicht schräg (Parallelogramm), feine Kante, Leuchten beim Drüberfahren ========== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#3A4766"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" Margin="4,0">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-12"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="sheen" Background="{DynamicResource ButtonSheenBrush}" CornerRadius="3" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-12"/>
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource NeonGlow}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Textfelder ========== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#D90B0F18"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#263049"/>
        <Setter Property="CaretBrush" Value="#22D3EE"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#3A4766"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#22D3EE"/>
                            <Setter TargetName="box" Property="Effect" Value="{StaticResource CyanGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="#D90B0F18"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#263049"/>
        <Setter Property="CaretBrush" Value="#22D3EE"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#3A4766"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#22D3EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Menüeinträge der Navigation (Seitenleiste links/rechts und Kopfleiste) ==========
         Schrift Chakra Petch, aktiver Eintrag als schräge Fläche mit Neonkante und leuchtendem Strich.
         In der Kopfleiste (Tag="dock") sitzt der Strich unten mittig. -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="plate" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Margin="3,0"
                                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-10"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="pill" Width="3" Height="20" CornerRadius="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource NavActiveBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="pillScale" ScaleX="1" ScaleY="0.2"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="dock">
                            <Setter TargetName="pill" Property="Width" Value="18"/>
                            <Setter TargetName="pill" Property="Height" Value="3"/>
                            <Setter TargetName="pill" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="pill" Property="VerticalAlignment" Value="Bottom"/>
                            <Setter TargetName="pill" Property="Margin" Value="0,0,0,2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="#1022D3EE"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="#4022D3EE"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="plate" Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
                            <Setter TargetName="plate" Property="BorderBrush" Value="__ACCENT40__"/>
                            <Setter TargetName="pill" Property="Opacity" Value="1"/>
                            <Setter TargetName="pill" Property="Effect" Value="{StaticResource NeonGlow}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleY" From="0.2" To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleX" From="0.2" To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Hinweis-Blasen ========== -->
    <Style x:Key="DockToolTip" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="Foreground" Value="#E8F0F8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="12" Background="#F20B0F18" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6"
                            Effect="{StaticResource NeonGlow}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SideToolTip" TargetType="ToolTip" BasedOn="{StaticResource DockToolTip}">
        <Setter Property="Placement" Value="Right"/>
    </Style>

    <!-- ========== Chips: schräg, beim Auswählen in der Akzentfarbe mit Leuchten ========== -->
    <Style x:Key="ChipStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="4,0">
                        <Border x:Name="chip" Background="#D9111622" BorderBrush="#263049" BorderThickness="1" CornerRadius="3" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-12"/>
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter Margin="14,6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#22D3EE"/>
                            <Setter Property="Foreground" Value="#E8F0F8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="chip" Property="Effect" Value="{StaticResource NeonGlow}"/>
                            <Setter Property="Foreground" Value="__INK__"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Fortschritt, Regler, Bildlauf ========== -->
    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Background" Value="#1A2133"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Effect="{StaticResource NeonGlow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="__ACCENT__" Offset="0"/>
                                    <GradientStop Color="#22D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Knob" Width="13" Height="13" Background="#E8F0F8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Effect" Value="{StaticResource NeonGlow}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Background" Value="#22D3EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderFilledButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#22D3EE" Offset="0"/>
                                <GradientStop Color="__ACCENT__" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmptyButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="26" Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="SliderTemplate" TargetType="Slider">
        <Grid Height="30" Background="Transparent">
            <Border Height="4" CornerRadius="2" Background="#263049" VerticalAlignment="Center" Margin="2,0"/>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFilledButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButtonStyle}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="Slider">
        <Setter Property="Template" Value="{StaticResource SliderTemplate}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Pill" CornerRadius="3" Background="#2A3550" Margin="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#22D3EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Schalter: Pille mit Neonleuchten, wenn an ========== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#E8F0F8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="46" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="#141A28" BorderBrush="#2E3A55" BorderThickness="1"/>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#7C8AA3" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#22D3EE"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="Effect" Value="{StaticResource NeonGlow}"/>
                            <Setter TargetName="Knob" Property="Fill" Value="White"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Rechtsklick-Menüs: dunkles Glas, Neonkante, Markierung mit Cyan-Strich ========== -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="#E8F0F8"/>
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="14" Background="#F50B0F18" BorderBrush="__ACCENT40__" BorderThickness="1" CornerRadius="10" Padding="5" Effect="{StaticResource HardShadow}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Margin" Value="10,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Rectangle Height="1" Fill="#263049"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="#E8F0F8"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Grid Margin="1">
                                    <Border x:Name="Hl" CornerRadius="6" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="__ACCENT40__" Offset="0"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="HlBar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,7" Background="#22D3EE" Opacity="0"/>
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="Check" Text="✓" Visibility="Hidden" FontWeight="Bold" Foreground="#22D3EE" VerticalAlignment="Center"/>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Collapsed" Margin="18,0,0,0" FontSize="16" Foreground="#22D3EE" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-10" VerticalOffset="-15" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Margin="14" Background="#F50B0F18" BorderBrush="__ACCENT40__" BorderThickness="1" CornerRadius="10" Padding="5" Effect="{StaticResource HardShadow}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Hl" Property="Opacity" Value="1"/>
                                    <Setter TargetName="HlBar" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#66758C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenu}"/>
</ResourceDictionary>
