<!--
    Thema 2 „Brutal“ (Neo-Brutalismus): fast schwarz mit feinem Raster, harte Kanten, dicke helle Rahmen,
    harte versetzte Schatten, schmale große Schrift, kein Glas, kein Leuchten.

    Diese Datei wird beim Start eingelesen (MainWindow.Theme.cs) und ersetzt gleichnamige Einträge aus MainWindow.xaml.
    Platzhalter, die vorher ersetzt werden:  __ACCENT__ (Akzentfarbe #RRGGBB),  __INK__ (Schrift auf der Akzentfarbe),
    __PAPER__ (helle Linien und Schrift).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Farben ========== -->
    <DrawingBrush x:Key="AppBackgroundBrush" TileMode="Tile" Viewport="0,0,44,44" ViewportUnits="Absolute" Viewbox="0,0,44,44" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0B0B">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,44,44"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#161616">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,44,1"/>
                            <RectangleGeometry Rect="0,0,1,44"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="SidebarBrush" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#121212"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="__PAPER__"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181818"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="__PAPER__"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BEBDB4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C8B83"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#5C5B56"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#141414"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#202020"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#5C5B56"/>
    <SolidColorBrush x:Key="CardFillBrush" Color="#121212"/>
    <SolidColorBrush x:Key="CardEdgeBrush" Color="__PAPER__"/>
    <SolidColorBrush x:Key="ButtonEdgeBrush" Color="__PAPER__"/>
    <SolidColorBrush x:Key="ButtonSheenBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="InkBrush" Color="__INK__"/>
    <SolidColorBrush x:Key="PaperBrush" Color="__PAPER__"/>

    <!-- Schrift: schmal und kräftig (Bahnschrift ist bei Windows dabei), Beschriftungen in Monospace -->
    <FontFamily x:Key="DisplayFont">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Segoe UI</FontFamily>

    <!-- Kein weicher Textschatten: alles flach -->
    <x:Null x:Key="TextShadow"/>

    <!-- Harte, versetzte Schatten (ohne Weichzeichner) -->
    <DropShadowEffect x:Key="HardShadow" BlurRadius="0" ShadowDepth="7" Direction="315" Opacity="1" Color="__ACCENT__"/>
    <DropShadowEffect x:Key="HardShadowSmall" BlurRadius="0" ShadowDepth="4" Direction="315" Opacity="1" Color="__PAPER__"/>

    <!-- ========== Texte ========== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="54"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextDecorations">
            <Setter.Value>
                <TextDecorationCollection>
                    <TextDecoration Location="Underline" PenOffset="8" PenOffsetUnit="Pixel" PenThicknessUnit="Pixel">
                        <TextDecoration.Pen>
                            <Pen Brush="__ACCENT__" Thickness="5"/>
                        </TextDecoration.Pen>
                    </TextDecoration>
                </TextDecorationCollection>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="EyebrowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="__ACCENT__"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ========== Karten ========== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardFillBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="Effect" Value="{StaticResource HardShadow}"/>
    </Style>

    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="#141414"/>
        <Setter Property="BorderBrush" Value="__PAPER__"/>
        <Setter Property="BorderThickness" Value="1.5,1.5,1.5,3"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="7,2"/>
    </Style>

    <!-- ========== Knöpfe: dicker Rahmen, harter Schatten; drüber = hebt sich, Klick = wird eingedrückt ========== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="__PAPER__"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" SnapsToDevicePixels="True" Margin="0,0,4,4">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="shift"/>
                        </Grid.RenderTransform>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                Effect="{StaticResource HardShadowSmall}"/>
                        <Border x:Name="hover" Background="#FFFFFF" Opacity="0" Margin="2" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.08"/>
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="-2" Y="-2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="4" Y="4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Textfelder ========== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#0E0E0E"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#5C5B56"/>
        <Setter Property="CaretBrush" Value="__ACCENT__"/>
        <Setter Property="SelectionBrush" Value="__ACCENT__"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="__PAPER__"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="__ACCENT__"/>
                            <Setter TargetName="box" Property="Effect" Value="{StaticResource HardShadow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="#0E0E0E"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="#5C5B56"/>
        <Setter Property="CaretBrush" Value="__ACCENT__"/>
        <Setter Property="SelectionBrush" Value="__ACCENT__"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="__PAPER__"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="__ACCENT__"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Navigation (oben in der Kopfleiste) ========== -->
    <Style x:Key="NavButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="border" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="__PAPER__"/>
                            <Setter Property="Foreground" Value="__PAPER__"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="__ACCENT__"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="__PAPER__"/>
                            <Setter Property="Foreground" Value="__INK__"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hinweis-Blasen: eckig, mit Rahmen in der Akzentfarbe. Die Kopfleiste ist oben, also erscheinen sie darunter -->
    <Style x:Key="DockToolTip" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Placement" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="6"/>
        <Setter Property="Foreground" Value="__INK__"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="0,0,6,6" Background="__ACCENT__" BorderBrush="__PAPER__" BorderThickness="2" Padding="10,5" Effect="{StaticResource HardShadowSmall}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SideToolTip" TargetType="ToolTip" BasedOn="{StaticResource DockToolTip}">
        <Setter Property="Placement" Value="Right"/>
        <Setter Property="VerticalOffset" Value="0"/>
    </Style>

    <!-- ========== Chips ========== -->
    <Style x:Key="ChipStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="chip" Background="#121212" BorderBrush="#5C5B56" BorderThickness="2" Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="__PAPER__"/>
                            <Setter Property="Foreground" Value="__PAPER__"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="__ACCENT__"/>
                            <Setter TargetName="chip" Property="BorderBrush" Value="__PAPER__"/>
                            <Setter TargetName="chip" Property="Effect" Value="{StaticResource HardShadowSmall}"/>
                            <Setter Property="Foreground" Value="__INK__"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Fortschritt, Regler, Bildlauf ========== -->
    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Background" Value="#1C1C1C"/>
        <Setter Property="Foreground" Value="__ACCENT__"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="PART_Track">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#5C5B56" BorderThickness="1.5"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" Margin="1.5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Knob" Background="__PAPER__" BorderBrush="#0B0B0B" BorderThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Background" Value="__ACCENT__"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Knob" Property="Background" Value="__ACCENT__"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderFilledButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="8" Background="__ACCENT__"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmptyButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="26" Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="SliderTemplate" TargetType="Slider">
        <Grid Height="30" Background="Transparent">
            <Border Height="8" Background="#1C1C1C" BorderBrush="#5C5B56" BorderThickness="1" VerticalAlignment="Center" Margin="2,0"/>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFilledButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButtonStyle}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="Slider">
        <Setter Property="Template" Value="{StaticResource SliderTemplate}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Block" Background="#5C5B56" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Block" Property="Background" Value="__ACCENT__"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Block" Property="Background" Value="__ACCENT__"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Width="14" Background="Transparent">
            <Border Background="#121212" BorderBrush="#262626" BorderThickness="1,0" Margin="2,0"/>
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Height="14" Background="Transparent">
            <Border Background="#121212" BorderBrush="#262626" BorderThickness="0,1" Margin="0,2"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Schalter: eckige Taste statt runder Pille ========== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="__PAPER__"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="50" Height="26" VerticalAlignment="Center">
                            <Border x:Name="Track" Background="#141414" BorderBrush="#5C5B56" BorderThickness="2"/>
                            <TextBlock x:Name="State" Text="0" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="#8C8B83"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <Border x:Name="Knob" Width="16" Height="16" Background="#8C8B83" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="__PAPER__"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="__ACCENT__"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="__PAPER__"/>
                            <Setter TargetName="Knob" Property="Background" Value="__PAPER__"/>
                            <Setter TargetName="State" Property="Text" Value="1"/>
                            <Setter TargetName="State" Property="Foreground" Value="__INK__"/>
                            <Setter TargetName="State" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="State" Property="Margin" Value="10,0,0,0"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Rechtsklick-Menüs: eckig, dicker Rahmen, harter Schatten, Markierung als volle Fläche ========== -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="__PAPER__"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="6,6,14,14" Background="#101010" BorderBrush="__PAPER__" BorderThickness="2" Padding="3" Effect="{StaticResource HardShadow}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Margin" Value="6,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Rectangle Height="2" Fill="#3A3A3A"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="__PAPER__"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="Hl" Background="__ACCENT__" Opacity="0"/>
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Check" Text="■" Visibility="Hidden" FontSize="11" Foreground="__ACCENT__" VerticalAlignment="Center"/>
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Arrow" Grid.Column="2" Text="▸" Visibility="Collapsed" Margin="18,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-5" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" AllowsTransparency="True" PopupAnimation="None">
                                    <Border Margin="6,6,14,14" Background="#101010" BorderBrush="__PAPER__" BorderThickness="2" Padding="3" Effect="{StaticResource HardShadow}">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Hl" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Check" Property="Foreground" Value="__INK__"/>
                                    <Setter Property="Foreground" Value="__INK__"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#6E6D66"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenu}"/>
</ResourceDictionary>
