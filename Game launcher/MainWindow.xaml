                                <StackPanel x:Name="StreamerChecklist"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== EINSTELLUNGEN ========== -->
                <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <TextBlock Text="Einstellungen" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Passe den Launcher an dich an. Unter jeder Option steht, was sie bewirkt." Style="{StaticResource SubtleText}" Margin="0,4,0,16" Effect="{StaticResource TextShadow}"/>
                        <Grid Margin="0,0,0,14" MaxWidth="520" HorizontalAlignment="Left" Width="520">
                            <TextBox x:Name="TxtSettingsSearch" Height="40" Padding="40,0,10,0" TextChanged="TxtSettingsSearch_TextChanged"/>
                            <TextBlock Text="🔍" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Segoe UI Emoji" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SettingsSearchHint" Text="Einstellungen durchsuchen ..." Margin="40,0,0,0" VerticalAlignment="Center"
                                   Foreground="#6B7280" IsHitTestVisible="False"/>
                        </Grid>
                        <WrapPanel Margin="0,0,0,18">
                            <RadioButton x:Name="ChipCatGeneral" Content="Allgemein" Tag="general" GroupName="SetCat" Style="{StaticResource ChipStyle}" IsChecked="True" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatLook" Content="Darstellung" Tag="look" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatSidebar" Content="Seitenleiste und Logo" Tag="sidebar" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatDash" Content="Dashboard" Tag="dash" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatGames" Content="Spiele und Cover" Tag="games" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatPerf" Content="Leistung" Tag="perf" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatControl" Content="Steuerung" Tag="control" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatStreamer" Content="Streamer" Tag="streamer" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatAuto" Content="Abläufe" Tag="auto" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatData" Content="Daten und Info" Tag="data" GroupName="SetCat" Style="{StaticResource ChipStyle}" Checked="SettingsCategory_Checked"/>
                            <RadioButton x:Name="ChipCatDev" Content="Entwickler" Tag="dev" GroupName="SetCat" Style="{StaticResource ChipStyle}" Visibility="Collapsed" Checked="SettingsCategory_Checked"/>
                        </WrapPanel>
                        <local:SettingsGridPanel x:Name="SettingsCards">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Tag="general">
                                <StackPanel>
                                    <TextBlock Text="Profil" Style="{StaticResource SectionTitle}"/>



                                    <StackPanel Margin="0,0,0,18">
                                        <TextBlock Text="Benutzername" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
