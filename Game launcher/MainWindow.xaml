                                        </StackPanel>
                                        <CheckBox x:Name="ChkSounds" Grid.Column="1" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
