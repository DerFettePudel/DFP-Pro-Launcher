                                    <WrapPanel x:Name="ObsScenePanel"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="GoLiveCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="⏱  Countdown „Gleich live“" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock x:Name="TxtGoLiveTime" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock Text="Zählt bis zum Livegang herunter. Die Checkliste unten aktualisiert sich dabei laufend, am Ende erscheint eine Meldung." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <StackPanel x:Name="GoLiveOptions">
                                    <TextBlock Text="Dauer" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="GoLiveMinutesPanel" Margin="0,0,0,10"/>
                                    <TextBlock Text="Danach diesen Ablauf starten" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="GoLiveRoutinePanel" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ChkGoLiveObs" Content="Danach in OBS den Stream starten" Margin="0,0,0,14" Checked="ChkGoLiveObs_Changed" Unchecked="ChkGoLiveObs_Changed"/>
                                </StackPanel>
                                <Border x:Name="GoLiveBar" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,0,0,14" Visibility="Collapsed">
                                    <Border x:Name="GoLiveFill" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="0"/>
                                </Border>
                                <WrapPanel>
                                    <Button x:Name="BtnGoLive" Content="Countdown starten" Margin="0,0,10,0" Padding="18,9" Background="{DynamicResource AccentBrush}" Click="BtnGoLive_Click"/>
                                    <Button x:Name="BtnGoLiveRoutine" Content="Ablauf „Stream-Start“ anlegen" Margin="0,0,10,0" Click="BtnGoLiveRoutine_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🎬  Streaming-Programme" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtStreamerAppsHint" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>
