                                        </StackPanel>
                                        <CheckBox x:Name="ChkDoubleClick" Grid.Column="1" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock Text="Vor dem Beenden warnen, wenn ein Spiel läuft" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
