                                            <TextBlock Text="Das Schließen-Kreuz versteckt den Launcher nur. Beenden kannst du ihn über das Symbol unten rechts." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkTray" Grid.Column="1" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                            <TextBlock Text="Symbol im Infobereich immer anzeigen" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="Zeigt das Symbol unten rechts neben der Uhr. Ein Klick öffnet das Schnell-Panel zum Starten von Spielen und Beenden." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkShowTray" Grid.Column="1" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
