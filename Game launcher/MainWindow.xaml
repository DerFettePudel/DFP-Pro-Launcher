                                        <TextBlock Text="Sprache der Oberfläche" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Die Änderung wirkt sofort. „Automatisch“ übernimmt die Sprache von Windows." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <RadioButton x:Name="ChipLangAuto" Content="Automatisch (Windows)" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
                                            <RadioButton x:Name="ChipLangDe" Content="Deutsch" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
                                            <RadioButton x:Name="ChipLangEn" Content="English" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
                                            <RadioButton x:Name="ChipLangZh" Content="中文" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
                                            <RadioButton x:Name="ChipLangEs" Content="Español" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
                                            <RadioButton x:Name="ChipLangFr" Content="Français" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
                                            <RadioButton x:Name="ChipLangPt" Content="Português" GroupName="Lang" Style="{StaticResource ChipStyle}" Checked="Language_Changed"/>
