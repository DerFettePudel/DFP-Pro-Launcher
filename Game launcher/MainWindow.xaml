<Window x:Class="Game_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Game_launcher"
        Title="DFP Pro Launcher" Height="800" Width="1360" MinWidth="1000" MinHeight="600"
        Background="{DynamicResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ========== Farben (werden in den Einstellungen geändert) ========== -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F111A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#0B0E16"/>
        <SolidColorBrush x:Key="CardBrush" Color="#131722"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181D2A"/>
        <DropShadowEffect x:Key="TextShadow" ShadowDepth="0" BlurRadius="7" Opacity="0.95" Color="#000000"/>
        <SolidColorBrush x:Key="NavTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="NavActiveBrush" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="NavActiveBgBrush" Color="#1C2233"/>

        <!-- Pinsel für das Logo -->
        <SolidColorBrush x:Key="BrandRingBrush" Color="#8B5CF6"/>
        <RadialGradientBrush x:Key="LogoBg" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Color="#1E2330" Offset="0"/>
            <GradientStop Color="#0B0D12" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="LogoGold" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FCD34D" Offset="0"/>
            <GradientStop Color="#F59E0B" Offset="0.5"/>
            <GradientStop Color="#B45309" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="LogoFur" Center="0.4,0.3" GradientOrigin="0.4,0.3" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#E2E8F0" Offset="0.7"/>
            <GradientStop Color="#CBD5E1" Offset="1"/>
        </RadialGradientBrush>


        <!-- ========== DFP Logo (aus deiner SVG nachgebaut) ========== -->
        <Viewbox x:Key="DfpLogo" x:Shared="False" Stretch="Uniform">
            <Canvas Width="500" Height="500">

                <Ellipse Canvas.Left="6" Canvas.Top="6" Width="488" Height="488" Fill="{StaticResource LogoBg}" Stroke="{StaticResource BrandRingBrush}" StrokeThickness="8"/>
                <Path Data="M 140 460 C 140 380, 200 350, 250 350 C 300 350, 360 380, 360 460 Z" Fill="{StaticResource LogoFur}"/>
                <Path Data="M 130 180 C 100 200, 110 320, 160 310 C 190 300, 180 220, 160 180 Z" Fill="#CBD5E1"/>
                <Path Data="M 370 180 C 400 200, 390 320, 340 310 C 310 300, 320 220, 340 180 Z" Fill="#CBD5E1"/>
                <Ellipse Canvas.Left="165" Canvas.Top="115" Width="170" Height="170" Fill="{StaticResource LogoFur}"/>
                <Ellipse Canvas.Left="185" Canvas.Top="70" Width="130" Height="90" Fill="#FFFFFF"/>
                <Ellipse Canvas.Left="180" Canvas.Top="95" Width="80" Height="60" Fill="#F8FAFC"/>
                <Ellipse Canvas.Left="240" Canvas.Top="95" Width="80" Height="60" Fill="#F8FAFC"/>
                <Ellipse Canvas.Left="212" Canvas.Top="207" Width="76" Height="56" Fill="#E2E8F0"/>
                <Path Data="M 235 220 Q 250 215 265 220 Q 268 235 250 242 Q 232 235 235 220 Z" Fill="#1E293B"/>
                <Ellipse Canvas.Left="200" Canvas.Top="175" Width="20" Height="20" Fill="#0F172A"/>
                <Ellipse Canvas.Left="204" Canvas.Top="179" Width="6" Height="6" Fill="#FFFFFF"/>
                <Ellipse Canvas.Left="280" Canvas.Top="175" Width="20" Height="20" Fill="#0F172A"/>
                <Ellipse Canvas.Left="284" Canvas.Top="179" Width="6" Height="6" Fill="#FFFFFF"/>
                <Path Data="M 240 248 Q 250 255 260 248" Stroke="#64748B" StrokeThickness="3"/>
                <Path Data="M 165 340 Q 250 410 335 340" Stroke="{StaticResource LogoGold}" StrokeThickness="16"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle Canvas.Left="203.5" Canvas.Top="358.5" Width="93" Height="58" RadiusX="10" RadiusY="10"
                           Fill="{StaticResource LogoGold}" Stroke="#78350F" StrokeThickness="3"/>
                <TextBlock Canvas.Left="205" Canvas.Top="364" Width="90" TextAlignment="Center" Text="DFP"
                           FontFamily="Arial Black" FontSize="30" FontWeight="Black" Foreground="#451A03"/>
            </Canvas>
        </Viewbox>

        <!-- ========== Basis-Styles ========== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource TextShadow}"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SubtleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Abgerundete Buttons mit Hover-Effekt (gilt für alle Buttons) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#374151"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abgerundete Textfelder -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AcceptsReturn" Value="True">
                                <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Passwortfelder wie die Textfelder -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation links -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B80E1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B28"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource NavActiveBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hinweis-Blase für die schwebende Leiste (statt Windows-Tooltip): oberhalb, mit Pfeil nach unten -->
        <Style x:Key="DockToolTip" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Top"/>
            <Setter Property="VerticalOffset" Value="-4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Grid x:Name="root" Margin="12" Opacity="0" RenderTransformOrigin="0.5,1">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="slide" Y="6"/>
                            </Grid.RenderTransform>
                            <StackPanel>
                                <Border Background="#F2161B28" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black"/>
                                    </Border.Effect>
                                    <ContentPresenter/>
                                </Border>
                                <Path Data="M0,0 L7,7 L14,0" Fill="#F2161B28" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                      HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="ToolTip.Opened">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hinweis-Blase für die eingeklappte Seitenleiste: daneben, ohne Pfeil -->
        <Style x:Key="SideToolTip" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Right"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border x:Name="root" Margin="12" Opacity="0" Background="#F2161B28" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="ToolTip.Opened">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter-Chips -->
        <Style x:Key="ChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" Background="#1F2937" CornerRadius="16" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#2A3142"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schlanker Fortschrittsbalken -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#8B5CF6"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="5"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spalten-Kopf der Tabelle -->
        <Style x:Key="DarkGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F131D"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- ========== Regler im App-Design ========== -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Halo" Width="32" Height="32" Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                            <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.22"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFilledButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="26" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="SliderTemplate" TargetType="Slider">
            <Grid Height="30" Background="Transparent">
                <Border Height="6" CornerRadius="3" Background="#2A3142" VerticalAlignment="Center" Margin="2,0"/>
                <Track x:Name="PART_Track" VerticalAlignment="Center">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFilledButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SliderThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="Slider">
            <Setter Property="Template" Value="{StaticResource SliderTemplate}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
        </Style>

        <!-- ========== Dunkle, schmale Bildlaufleisten ========== -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pill" CornerRadius="4" Background="#3A4156" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="12" Background="Transparent">
                <Border CornerRadius="6" Background="#14FFFFFF" Margin="3,0"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,2">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="12" Background="Transparent">
                <Border CornerRadius="6" Background="#14FFFFFF" Margin="0,3"/>
                <Track x:Name="PART_Track" Margin="2,0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========== Animierter Schalter (ersetzt die Häkchen) ========== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="46" Height="26" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="13" Background="#374151" BorderBrush="#4B5563" BorderThickness="1"/>
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobMove" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Label" Property="Margin" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Dunkle Kontextmenüs ========== -->
        <!-- Rechtsklick-Menüs im Launcher-Design: abgerundet, Schatten, Markierung in der Akzentfarbe, sanftes Einblenden -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="menuRoot" Margin="10,6,14,16" Opacity="0" Background="#F2131722" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="menuSlide" Y="-4"/>
                            </Border.RenderTransform>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="ContextMenu.Opened">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="menuRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="menuSlide" Storyboard.TargetProperty="Y" From="-4" To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                    <Setter Property="Margin" Value="10,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Rectangle Height="1" Fill="#22FFFFFF"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E5E7EB"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Grid Margin="1">
                                        <!-- Markierung: Akzentfarbe, halb durchsichtig, mit Strich links -->
                                        <Border x:Name="Hl" CornerRadius="8" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                                        <Border x:Name="HlBar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,7" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Check" Text="✓" Visibility="Hidden" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Arrow" Grid.Column="2" Text="›" Visibility="Collapsed" Margin="18,0,0,0" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6" VerticalOffset="-11" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Margin="6,6,14,16" Background="#F2131722" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="5">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black"/>
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Hl" Property="Opacity" Value="0.22"/>
                                        <Setter TargetName="HlBar" Property="Opacity" Value="1"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenu}"/>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="WindowRoot">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="BackgroundDim" Background="{DynamicResource AppBackgroundBrush}" Opacity="0.55" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="BackgroundGlow" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Grid x:Name="RootGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSidebar" Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
                <Grid Margin="16,38,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo und Name -->
                    <Grid Margin="4,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="BrandLogo" Content="{StaticResource DfpLogo}" Width="54" Height="54" VerticalAlignment="Center"/>
                        <Viewbox x:Name="BrandTextHost" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel x:Name="BrandText">
                                <TextBlock x:Name="BrandTitle" Text="DFP PRO" Foreground="White" FontSize="20" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="BrandSubtitle" Text="LAUNCHER" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Viewbox>
                    </Grid>

                    <!-- Benutzer -->
                    <Border x:Name="UserCard" Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="TxtWelcomeGreeting" Text="Willkommen zurück" Foreground="#9CA3AF" FontSize="12"/>
                            <TextBlock x:Name="TxtUserName" Text="Gamer" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                            <Border x:Name="StreamBadge" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,3" CornerRadius="8" Background="#33DC2626"
                                Cursor="Hand" ToolTip="Klicken zum Ausschalten" HorizontalAlignment="Left" MouseLeftButtonUp="StreamBadge_Click">
                                <TextBlock x:Name="TxtStreamBadge" Text="📡 Streamer-Modus" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel x:Name="NavPanel">
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" IsChecked="True" x:Name="NavDashboardBtn" Click="NavDashboard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏠" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Dashboard"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavGamesBtn" Click="NavGames_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎮" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Spiele"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavStatsBtn" Style="{StaticResource NavButtonStyle}" GroupName="Nav" Click="NavStats_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📈" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Statistik"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavDealsBtn" Style="{StaticResource NavButtonStyle}" GroupName="Nav" Click="NavDeals_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎁" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Angebote"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavBacklogBtn" Style="{StaticResource NavButtonStyle}" GroupName="Nav" Click="NavBacklog_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Backlog"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavGalleryBtn" Style="{StaticResource NavButtonStyle}" GroupName="Nav" Click="NavGallery_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Galerie"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavAppsBtn" Click="NavApps_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧩" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Anwendungen"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavLinksBtn" Click="NavLinks_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔗" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Schnellzugriff"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavWishBtn" Click="NavWishlist_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💝" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Wunschliste"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavDownloadsBtn" Click="NavDownloads_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Downloads"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavSystemBtn" Click="NavSystem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Systemüberwachung"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavStorageBtn" Click="NavStorage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Speicher"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavOptimizationBtn" Click="NavOptimization_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Optimierung"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavToolsBtn" Click="NavTools_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛠" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Tools"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavStreamerBtn" Style="{StaticResource NavButtonStyle}" GroupName="Nav" Click="NavStreamer_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📡" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Streamer"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Nav" x:Name="NavSettingsBtn" Click="NavSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚙" Width="30" FontFamily="Segoe UI Emoji"/>
                                        <TextBlock Text="Einstellungen"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <StackPanel x:Name="SidebarExtras" Margin="0,0,0,8"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button x:Name="BtnSidebar" Content="«" ToolTip="Seitenleiste ein- oder ausklappen" Padding="14,6"
                            Background="#161B28" Click="BtnSidebar_Click"/>
                        <TextBlock x:Name="SidebarFooterText" Text="Strg+K  Suche" Foreground="#4B5563" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SidebarCredit" Grid.Row="4" Text="by Der_Fette_Pudel" Foreground="#4B5563" FontSize="11" Margin="4,8,0,0"/>
                </Grid>
            </Border>

            <!-- Dunkler Verlauf oben: macht Titel und Knöpfe auf hellen Hintergrundbildern lesbar -->
            <Border x:Name="TopScrim" Grid.Column="1" Height="130" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="5" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3000000" Offset="0"/>
                        <GradientStop Color="#66000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ================= INHALT ================= -->
            <Grid x:Name="ContentArea" Grid.Column="1" Margin="28,42,16,16">

                <!-- ========== DASHBOARD ========== -->
                <ScrollViewer x:Name="ViewDashboard" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DashStack" Margin="0,0,12,24">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock x:Name="TxtGreeting" Text="Hallo" FontSize="30" FontWeight="Bold" Foreground="White" Effect="{StaticResource TextShadow}"/>
                                <TextBlock x:Name="TxtDate" Style="{StaticResource SubtleText}" FontSize="14" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border x:Name="DownloadPill" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="14,8,14,9" Margin="0,0,10,0" MouseLeftButtonUp="DownloadPill_Click">
                                    <StackPanel MinWidth="200">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬇" FontWeight="Bold" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock x:Name="TxtDlName" Foreground="White" FontWeight="SemiBold" FontSize="12" MaxWidth="210" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDlInfo" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,7"/>
                                        <Grid Height="3">
                                            <Border Background="#26FFFFFF" CornerRadius="1.5"/>
                                            <Border x:Name="DlFill" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="DlFillScale" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Padding="18,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtMiniCpu" Text="CPU --%" Foreground="#60A5FA" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="TxtMiniRam" Text="RAM --%" Foreground="#A78BFA" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="TxtMiniGpu" Text="GPU --%" Foreground="#34D399" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="BannerHost"/>
                        <ContentControl x:Name="HeroHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" Margin="0,0,0,16"/>

                        <Grid x:Name="WidgetsRow" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition x:Name="ColWeather" Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ClockCard" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="UHRZEIT" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtClock" Text="--:--" FontSize="46" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtClockDate" Style="{StaticResource SubtleText}"/>
                                    <TextBlock x:Name="TxtClockWeek" Foreground="#6B7280" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="WeatherCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtWeatherIcon" Text="🌡" FontSize="56" FontFamily="Segoe UI Emoji" Foreground="White"
                                           VerticalAlignment="Center" Margin="0,0,18,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="WETTER" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtWeatherTemp" Text="--" FontSize="36" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="TxtWeatherDesc" Text="Wird geladen ..." Foreground="White" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtWeatherDetails" Style="{StaticResource SubtleText}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtWeatherRange" Foreground="#6B7280" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <UniformGrid x:Name="StatsGrid" Columns="4" Margin="0,0,0,28">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatGames" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Spiele in der Bibliothek" Style="{StaticResource SubtleText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatFavs" Text="0" FontSize="32" FontWeight="Bold" Foreground="#FBBF24"/>
                                    <TextBlock Text="Favoriten" Style="{StaticResource SubtleText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatPlaytime" Text="0 Min." FontSize="30" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock Text="Gesamtspielzeit" Style="{StaticResource SubtleText}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatLast" Text="–" FontSize="22" FontWeight="Bold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,6"/>
                                    <TextBlock Text="Zuletzt gespielt" Style="{StaticResource SubtleText}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel x:Name="RecentSection">
                            <TextBlock Text="Zuletzt gespielt" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TxtRecentEmpty" Text="Noch nichts gestartet. Starte ein Spiel über den Launcher, dann erscheint es hier."
                                   Foreground="#6B7280" Margin="0,0,0,20"/>
                            <WrapPanel x:Name="RecentContainer" Margin="-12,0,0,12"/>
                        </StackPanel>

                        <StackPanel x:Name="FavSection" Visibility="Collapsed">
                            <TextBlock x:Name="TxtFavTitle" Text="Favoriten" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel x:Name="FavoritesContainer" Margin="-12,0,0,12"/>
                        </StackPanel>

                        <TextBlock x:Name="DashActionsTitle" Text="Schnellaktionen" Style="{StaticResource SectionTitle}" Margin="0,8,0,12"/>
                        <WrapPanel x:Name="DashActions">
                            <Button Content="🎲  Zufälliges Spiel" Padding="18,11" Margin="0,0,10,10"
                                Background="{DynamicResource AccentBrush}" Click="BtnRandomGame_Click"/>
                            <Button Content="＋  Spiel hinzufügen" Padding="18,11" Margin="0,0,10,10" Click="BtnAddGame_Click"/>
                            <Button Content="🔄  Neu scannen" Padding="18,11" Margin="0,0,10,10" Click="BtnRescanGames_Click"/>
                            <Button Content="🔍  Suche (Strg+K)" Padding="18,11" Margin="0,0,10,10" Click="BtnSpotlight_Click"/>
                            <Button Content="🎮  Controller-Modus (F11)" Padding="18,11" Margin="0,0,10,10" Click="BtnController_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== SPIELE ========== -->
                <Grid x:Name="ViewGames" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Spiele" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="TxtGameCount" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource SubtleText}" Effect="{StaticResource TextShadow}"/>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="TxtSearch" Text="Spiel suchen..." Width="260" Height="38"
                                 TextChanged="TxtSearch_TextChanged" PreviewKeyDown="TxtSearch_PreviewKeyDown" GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"/>
                            <Button Content="＋ Spiel hinzufügen" Margin="12,0,0,0" Background="{DynamicResource AccentBrush}" Click="BtnAddGame_Click"/>
                            <Button Content="Neu scannen" Margin="10,0,0,0" Click="BtnRescanGames_Click"/>
                            <Button Content="🎯 Was soll ich spielen?" Margin="10,0,0,0" Click="BtnSuggestGame_Click"/>
                            <Button x:Name="BtnSort" Content="Sortierung: Name (A–Z)" Margin="10,0,0,0" Click="BtnSort_Click"/>
                        </StackPanel>
                        <WrapPanel x:Name="FilterChips" Margin="0,0,0,8">
                            <RadioButton Content="Alle" Tag="all" IsChecked="True" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="★ Favoriten" Tag="fav" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="🆕 Neu" Tag="new" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="🎲 Ungespielt" Tag="unplayed" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="🙈 Versteckt" Tag="hidden" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Steam" Tag="Steam" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Epic Games" Tag="Epic Games" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Xbox" Tag="Xbox" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Rockstar" Tag="Rockstar" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="GOG" Tag="GOG" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="EA" Tag="EA" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Ubisoft" Tag="Ubisoft" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Battle.net" Tag="Battle.net" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <RadioButton Content="Manuell" Tag="Manuell" GroupName="Filter" Style="{StaticResource ChipStyle}" Checked="Filter_Checked"/>
                            <Button x:Name="BtnGenre" Content="🏷 Genre" Margin="0,0,8,8" Padding="14,6" Background="#1F2937" Foreground="#9CA3AF" FontSize="13" Click="BtnGenre_Click"/>
                            <Button x:Name="BtnBulk" Content="☑ Auswahl bearbeiten" Margin="0,0,8,8" Padding="14,6" Background="#1F2937" Foreground="#9CA3AF" FontSize="13" Click="BtnBulk_Click" ToolTip="Tipp: Mit Strg+Klick markierst du mehrere Spiele direkt, ein Rechtsklick bearbeitet dann alle zusammen."/>
                            <Button x:Name="BtnSmartList" Content="＋ Smarte Liste" Margin="0,0,8,8" Padding="14,6" Background="#1F2937" Foreground="#9CA3AF" FontSize="13" Click="BtnSmartList_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <ScrollViewer x:Name="GamesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel x:Name="GamesContainer" Margin="-12,0,0,0"/>
                            <StackPanel x:Name="GamesListContainer" Visibility="Collapsed" Margin="0,0,12,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="FlowHost" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:CoverFlowControl x:Name="LibraryFlow" ItemWidth="220" ItemHeight="330" Margin="0,6,0,6"/>
                        <TextBlock x:Name="TxtFlowEmpty" Text="Keine Treffer." Style="{StaticResource SubtleText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,8">
                            <TextBlock x:Name="TxtFlowTitle" FontSize="30" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="900" Effect="{StaticResource TextShadow}"/>
                            <TextBlock x:Name="TxtFlowMeta" Style="{StaticResource SubtleText}" TextAlignment="Center" Margin="0,4,0,12" Effect="{StaticResource TextShadow}"/>
                            <StackPanel x:Name="FlowActions" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="▶  Spielen" Padding="30,10" Background="{DynamicResource AccentBrush}" Click="BtnFlowPlay_Click"/>
                                <Button Content="📝  Details" Margin="10,0,0,0" Padding="22,10" Click="BtnFlowDetails_Click"/>
                                <Button x:Name="BtnFlowFav" Content="☆  Favorit" Margin="10,0,0,0" Padding="22,10" Click="BtnFlowFav_Click"/>
                            </StackPanel>
                            <TextBlock Text="← → blättern · Mausrad · Enter startet das Spiel" Style="{StaticResource SubtleText}" FontSize="11" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Viewbox x:Name="AlphaHost" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" MaxHeight="560" Margin="0,0,18,0"
                         Visibility="Collapsed" Panel.ZIndex="5">
                        <StackPanel x:Name="AlphaBar" Width="20"/>
                    </Viewbox>
                </Grid>

                <!-- ========== STATISTIK ========== -->
                <ScrollViewer x:Name="ViewStats" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <TextBlock Text="Statistik" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Deine Spielzeit wird automatisch erfasst, sobald ein Spiel läuft." Style="{StaticResource SubtleText}" Margin="0,4,0,12" Effect="{StaticResource TextShadow}"/>
                        <Button Content="🎉  Mein Spielejahr" HorizontalAlignment="Left" Margin="0,0,0,18" Click="BtnYearReview_Click"/>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="GESAMTSPIELZEIT" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatsTotal" Text="0 Min." FontSize="26" FontWeight="Bold" Foreground="#34D399" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LETZTE 7 TAGE" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatsWeek" Text="0 Min." FontSize="26" FontWeight="Bold" Foreground="#60A5FA" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="MEISTGESPIELT" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatsTop" Text="–" FontSize="22" FontWeight="Bold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📅  Aktivität (letzte 26 Wochen)" Style="{StaticResource SectionTitle}"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Grid x:Name="HeatmapGrid" HorizontalAlignment="Left" Margin="0,4,0,8"/>
                                </ScrollViewer>
                                <TextBlock x:Name="TxtHeatmapInfo" Style="{StaticResource SubtleText}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="GoalCard" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🎯  Wochenziel" Style="{StaticResource SectionTitle}"/>
                                <ProgressBar x:Name="GoalProgress" Style="{StaticResource SlimProgress}" Height="12" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="TxtGoalText" Style="{StaticResource SubtleText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Letzte 7 Tage" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid x:Name="WeekChart" Rows="1" Columns="7" Height="210"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Meistgespielte Spiele" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="TxtStatsEmpty" Text="Noch keine Spielzeit erfasst. Starte ein Spiel, der Launcher misst die Zeit automatisch."
                                       Foreground="#6B7280" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="TopGamesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" Foreground="#6B7280" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Margin="0,6,0,0"
                                                             Value="{Binding Percent, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="🏆  Erfolge" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock x:Name="TxtAchievementCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleText}"/>
                                </Grid>
                                <ItemsControl x:Name="AchievementsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="270" Margin="0,0,12,12" Padding="14" CornerRadius="14" Background="#181D2A" Opacity="{Binding Opacity}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="30" FontFamily="Segoe UI Emoji" Foreground="White"
                                                           VerticalAlignment="Top" Margin="0,0,14,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                                        <ProgressBar Style="{StaticResource SlimProgress}" Height="5" Value="{Binding Percent, Mode=OneWay}" Foreground="#FBBF24"/>
                                                        <TextBlock Text="{Binding ProgressText}" Foreground="#6B7280" FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== ANGEBOTE ========== -->
                <ScrollViewer x:Name="ViewDeals" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Angebote" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Gratis-Spiele bei Epic Games und aktuelle Rabatte bei Steam." Style="{StaticResource SubtleText}" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                            </StackPanel>
                            <Button x:Name="BtnRefreshDeals" Content="Aktualisieren" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}" Click="BtnRefreshDeals_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtDealsStatus" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Image x:Name="ImgEpicFree" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Epic Games Store – jetzt gratis" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="Diese Spiele kannst du aktuell kostenlos in deine Bibliothek holen und behalten." Style="{StaticResource SubtleText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel x:Name="EpicFreeContainer" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Image x:Name="ImgEpicSoon" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Epic Games Store – demnächst gratis" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="Diese Spiele sind als Nächstes kostenlos. Das Datum steht auf der Karte." Style="{StaticResource SubtleText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel x:Name="EpicUpcomingContainer" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Image x:Name="ImgSteamDeals" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Steam – aktuelle Rabatte" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="Die größten Preisnachlässe im Steam-Shop. Die Prozentangabe zeigt die Ersparnis." Style="{StaticResource SubtleText}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <WrapPanel x:Name="SteamDealsContainer"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== BACKLOG UND PLANER ========== -->
                <Grid x:Name="ViewBacklog" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Backlog und Planer" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Ziehe Spiele zwischen den Spalten. Doppelklick startet ein Spiel. Mit ＋ fügst du mehrere auf einmal hinzu."
                               Style="{StaticResource SubtleText}" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Tag="backlog" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop"
                            Style="{StaticResource CardStyle}" Margin="0,0,12,12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="📋  Will ich spielen" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <Button Content="＋" Tag="backlog" HorizontalAlignment="Right" Padding="12,4" Click="BtnBoardAdd_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="BoardBacklog"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Tag="playing" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop"
                            Style="{StaticResource CardStyle}" Margin="0,0,12,12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="▶  Spiele ich gerade" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <Button Content="＋" Tag="playing" HorizontalAlignment="Right" Padding="12,4" Click="BtnBoardAdd_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="BoardPlaying"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Tag="done" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop"
                            Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="✅  Durchgespielt" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <Button Content="＋" Tag="done" HorizontalAlignment="Right" Padding="12,4" Click="BtnBoardAdd_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="BoardDone"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="🗓  Bald erscheinend" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Button Content="＋ Termin" HorizontalAlignment="Right" Padding="12,5" Click="BtnAddRelease_Click"/>
                            </Grid>
                            <StackPanel x:Name="ReleasesList"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========== GALERIE ========== -->
                <Grid x:Name="ViewGallery" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Galerie" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Deine neuesten Screenshots aus Windows, Xbox Game Bar und Steam." Style="{StaticResource SubtleText}" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Ordner hinzufügen" Margin="0,0,10,0" Click="BtnAddShotFolder_Click"/>
                            <Button Content="Aktualisieren" Background="{DynamicResource AccentBrush}" Click="BtnRefreshGallery_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtGalleryStatus" Grid.Row="1" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,0,0,14"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="GalleryContainer"/>
                    </ScrollViewer>
                </Grid>

                <!-- ========== ANWENDUNGEN ========== -->
                <Grid x:Name="ViewApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <StackPanel Margin="0,0,560,0">
                            <TextBlock Text="Anwendungen" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="TxtAppsSubtitle" Style="{StaticResource SubtleText}" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Grid Width="230" Margin="0,0,8,0">
                                <TextBox x:Name="TxtAppSearch" Height="38" Padding="36,0,10,0" TextChanged="TxtAppSearch_TextChanged"/>
                                <TextBlock Text="🔍" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       FontFamily="Segoe UI Emoji" IsHitTestVisible="False"/>
                                <TextBlock x:Name="AppSearchHint" Text="App suchen ..." Margin="38,0,0,0" VerticalAlignment="Center"
                                       Foreground="#6B7280" IsHitTestVisible="False"/>
                            </Grid>
                            <Button Content="🔄" ToolTip="Neu laden" Width="40" Height="38" Margin="0,0,8,0" Click="BtnRefreshApps_Click"/>
                            <Button Content="＋ App hinzufügen" Height="38" Background="{DynamicResource AccentBrush}" Click="BtnAddApp_Click"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel x:Name="AppsFilterPanel" Grid.Row="1" Margin="0,0,0,14"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <WrapPanel x:Name="AppsContainer"/>
                            <TextBlock x:Name="TxtAppsEmpty" Text="Keine Apps erkannt. Füge deine Programme mit „App hinzufügen“ selbst hinzu."
                                   Foreground="#6B7280" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========== SCHNELLZUGRIFF ========== -->
                <Grid x:Name="ViewLinks" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <StackPanel Margin="0,0,330,0">
                            <TextBlock Text="Schnellzugriff" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Deine eigenen Verknüpfungen zu Webseiten, Programmen und Ordnern. Rechtsklick auf eine Kachel zum Bearbeiten, Verschieben oder Entfernen."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Standard wiederherstellen" Margin="0,0,8,0" Click="BtnResetQuick_Click"/>
                            <Button Content="＋ Hinzufügen" Background="{DynamicResource AccentBrush}" Click="BtnAddQuick_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="QuickContainer" Margin="0,0,0,24"/>
                    </ScrollViewer>
                </Grid>

                <!-- ========== WUNSCHLISTE ========== -->
                <Grid x:Name="ViewWishlist" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <StackPanel Margin="0,0,330,0">
                            <TextBlock Text="Wunschliste" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Trage Steam-Spiele ein, die du gern hättest. Der Launcher prüft die Preise und meldet sich, sobald dein Zielpreis erreicht ist."
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                            <TextBlock x:Name="TxtWishStatus" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="🔄  Preise prüfen" Margin="0,0,8,0" Click="BtnWishRefresh_Click"/>
                            <Button Content="＋ Hinzufügen" Background="{DynamicResource AccentBrush}" Click="BtnWishAdd_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="WishContainer" Margin="0,0,0,24"/>
                    </ScrollViewer>
                </Grid>

                <!-- ========== DOWNLOADS ========== -->
                <Grid x:Name="ViewDownloads" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Downloads" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Deine zuletzt heruntergeladenen Dateien." Style="{StaticResource SubtleText}" Margin="0,4,0,0" Effect="{StaticResource TextShadow}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,12">
                        <StackPanel>
                            <TextBlock Text="Download-Ordner" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TxtDownloadsInfo" Style="{StaticResource SubtleText}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Content="Öffnen" Margin="0,0,8,0" Padding="12,7" Click="BtnOpenDownload_Click"/>
                            <Button Content="Im Ordner zeigen" Margin="0,0,8,0" Padding="12,7" Click="BtnShowDownload_Click"/>
                            <Button Content="Ordner öffnen" Margin="0,0,8,0" Padding="12,7" Click="BtnOpenDownloadsFolder_Click"/>
                            <Button Content="Aktualisieren" Padding="12,7" Background="{DynamicResource AccentBrush}" Click="BtnRefreshDownloads_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="GridDownloads" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="36"
                          Background="{DynamicResource CardBrush}" RowBackground="{DynamicResource CardBrush}" AlternatingRowBackground="#161B28"
                          Foreground="White" BorderThickness="0" ColumnHeaderStyle="{StaticResource DarkGridHeader}"
                          MouseDoubleClick="GridDownloads_DoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datei" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="110"/>
                            <DataGridTextColumn Header="Geändert" Binding="{Binding DateText}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ========== SYSTEMÜBERWACHUNG ========== -->
                <ScrollViewer x:Name="ViewSystem" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <TextBlock Text="Systemüberwachung" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Live-Auslastung deines PCs, aktualisiert jede Sekunde." Style="{StaticResource SubtleText}" Margin="0,4,0,20" Effect="{StaticResource TextShadow}"/>

                        <UniformGrid Columns="3">
                            <!-- CPU -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="PROZESSOR" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtCpuName" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Margin="0,6,0,0"/>
                                    <Grid Width="150" Height="150" Margin="0,14">
                                        <Ellipse Stroke="#1F2937" StrokeThickness="12"/>
                                        <Path x:Name="ArcCpu" Stroke="#60A5FA" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtCpuPercent" Text="0%" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCpuSub" Text="CPU" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtCpuDetail" Foreground="#D1D5DB" FontSize="12" TextAlignment="Center" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Canvas x:Name="CanvasCpu" Height="44" ClipToBounds="True">
                                        <Polygon x:Name="PolyCpu" Fill="#3360A5FA" Stroke="#60A5FA" StrokeThickness="1.5"/>
                                    </Canvas>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="ARBEITSSPEICHER" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtRamName" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Margin="0,6,0,0"/>
                                    <Grid Width="150" Height="150" Margin="0,14">
                                        <Ellipse Stroke="#1F2937" StrokeThickness="12"/>
                                        <Path x:Name="ArcRam" Stroke="#A78BFA" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtRamPercent" Text="0%" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRamSub" Text="RAM" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtRamDetail" Foreground="#D1D5DB" FontSize="12" TextAlignment="Center" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Canvas x:Name="CanvasRam" Height="44" ClipToBounds="True">
                                        <Polygon x:Name="PolyRam" Fill="#33A78BFA" Stroke="#A78BFA" StrokeThickness="1.5"/>
                                    </Canvas>
                                </StackPanel>
                            </Border>

                            <!-- GPU -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="GRAFIKKARTE" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtGpuName" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" Margin="0,6,0,0"/>
                                    <Grid Width="150" Height="150" Margin="0,14">
                                        <Ellipse Stroke="#1F2937" StrokeThickness="12"/>
                                        <Path x:Name="ArcGpu" Stroke="#34D399" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtGpuPercent" Text="0%" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGpuSub" Text="GPU" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtGpuDetail" Foreground="#D1D5DB" FontSize="12" TextAlignment="Center" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Canvas x:Name="CanvasGpu" Height="44" ClipToBounds="True">
                                        <Polygon x:Name="PolyGpu" Fill="#3334D399" Stroke="#34D399" StrokeThickness="1.5"/>
                                    </Canvas>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Laufwerke" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                    <StackPanel x:Name="DriveRows"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Netzwerk" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="TxtNetDown" Text="↓ –" FontSize="26" FontWeight="Bold" Foreground="#34D399"/>
                                    <TextBlock x:Name="TxtNetUp" Text="↑ –" FontSize="26" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,6"/>
                                    <TextBlock x:Name="TxtNetName" Style="{StaticResource SubtleText}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Netzwerk und Ping" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtPingInfo" Text="Teste deine Verbindung zu Router, DNS und Spiele-Diensten." Style="{StaticResource SubtleText}" FontSize="12"/>
                                    </StackPanel>
                                    <Button x:Name="BtnPing" Content="Jetzt testen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}" Click="BtnPing_Click"/>
                                </Grid>
                                <ItemsControl x:Name="PingList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="230"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center"/>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource SlimProgress}" Height="8" Margin="8,0,16,0"
                                                         Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding BarBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Dein System" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtHardwareStatus" Style="{StaticResource SubtleText}" FontSize="12"/>
                                    </StackPanel>
                                    <Button x:Name="BtnRefreshHardware" Content="Neu auslesen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}" Click="BtnRefreshHardware_Click"/>
                                </Grid>
                                <ItemsControl x:Name="HardwareList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,12,0,4">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                       FontSize="13" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="180"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="White" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SensorCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🌡  Temperaturen und Lüfter" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="TxtSensorStatus" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap"/>
                                <StackPanel x:Name="SensorHelp" Margin="0,10,0,0" Visibility="Collapsed"/>
                                <StackPanel x:Name="SensorPanel"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== SPEICHER ========== -->
                <ScrollViewer x:Name="ViewStorage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <TextBlock Text="Speicher" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Belegung deiner Laufwerke und der Platzbedarf deiner Spiele." Style="{StaticResource SubtleText}" Margin="0,4,0,20" Effect="{StaticResource TextShadow}"/>

                        <ItemsControl x:Name="DrivesControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding DriveName}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding PercentText}" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding InfoText}" Foreground="#9CA3AF" Margin="0,2,0,10"/>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Foreground="{Binding BarBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Speicherbedarf der Spiele" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtGameSizesInfo" Text="Berechnet, wie viel Platz jedes Spiel belegt." Style="{StaticResource SubtleText}" FontSize="12"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCalcGameSizes" Content="Berechnen" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}" Click="BtnCalcGameSizes_Click"/>
                                </Grid>
                                <ItemsControl x:Name="GameSizesControl" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,100,0"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource SlimProgress}" Height="6" Margin="0,5,0,0"
                                                         Value="{Binding Percent, Mode=OneWay}" Foreground="#60A5FA"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== OPTIMIERUNG ========== -->
                <ScrollViewer x:Name="ViewOptimization" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,24">
                        <TextBlock Text="Optimierung" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Mehr Leistung und Platz für deine Spiele." Style="{StaticResource SubtleText}" Margin="0,4,0,20" Effect="{StaticResource TextShadow}"/>

                        <!-- Gaming-Check -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="150" Height="150" Margin="0,0,28,0">
                                    <Ellipse Stroke="#1F2937" StrokeThickness="12"/>
                                    <Path x:Name="ArcGamingCheck" Stroke="{DynamicResource AccentBrush}" StrokeThickness="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtGamingCheckScore" Text="0/4" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="erfüllt" FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Gaming-Check" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtGamingCheckHint" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock x:Name="IconCheckPower" Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="Energieplan: Höchstleistung" Foreground="#D1D5DB"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock x:Name="IconCheckGameMode" Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="Spielmodus ist an" Foreground="#D1D5DB"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock x:Name="IconCheckMouse" Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="Mausbeschleunigung ist aus" Foreground="#D1D5DB"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0">
                                        <TextBlock x:Name="IconCheckDvr" Text="✓" Foreground="#34D399" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="Hintergrundaufnahme ist aus" Foreground="#D1D5DB"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Energieplan -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="⚡  Energiesparplan" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtPowerPlan" Text="Aktiver Plan: ..." Foreground="#34D399" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button Content="Energieoptionen" Tag="powercfg.cpl" Click="BtnOpenSetting_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                                <TextBlock Text="Klicke auf einen Plan, um ihn sofort zu aktivieren." Style="{StaticResource SubtleText}" Margin="0,10,0,14"/>
                                <UniformGrid Columns="4">
                                    <Border x:Name="PlanSaver" Tag="a1841308-3541-4fab-bc81-f71556f20b4a" Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="PlanTile_Click">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Energiesparen" Foreground="White" FontWeight="SemiBold"/>
                                                <Border x:Name="BadgePlanSaver" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2"
                                                Background="{DynamicResource AccentBrush}">
                                                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Spart Strom, weniger Leistung" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PlanBalanced" Tag="381b4222-f694-41f0-9685-ff5bb260df2e" Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="PlanTile_Click">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Ausbalanciert" Foreground="White" FontWeight="SemiBold"/>
                                                <Border x:Name="BadgePlanBalanced" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2"
                                                Background="{DynamicResource AccentBrush}">
                                                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Empfohlen, passt sich automatisch an" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PlanHigh" Tag="8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c" Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="PlanTile_Click">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Höchstleistung" Foreground="White" FontWeight="SemiBold"/>
                                                <Border x:Name="BadgePlanHigh" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2"
                                                Background="{DynamicResource AccentBrush}">
                                                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Höhere Taktraten, etwas mehr Stromverbrauch" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PlanUltimate" Tag="e9a42b02-d5df-448d-aa00-03f14749eb61" Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="16,14" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonUp="PlanTile_Click">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Ultimative Leistung" Foreground="White" FontWeight="SemiBold"/>
                                                <Border x:Name="BadgePlanUltimate" Visibility="Collapsed" HorizontalAlignment="Right" CornerRadius="8" Padding="8,2"
                                                Background="{DynamicResource AccentBrush}">
                                                    <TextBlock Text="Aktiv" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="Maximale Leistung, keine Stromsparfunktionen" Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Windows für Spiele und Grafiktreiber -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="🕹  Windows für Spiele" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Diese Windows-Einstellungen wirken sich direkt auf deine Spiele aus."
                                           Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Spielmodus" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock Text="Windows gibt dem Spiel Vorrang und hält Updates im Hintergrund zurück." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkGameMode" Grid.Column="1" VerticalAlignment="Center" Checked="ChkGameMode_Changed" Unchecked="ChkGameMode_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Hintergrundaufnahme" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock Text="Nimmt ständig die letzten Minuten auf. Aus bedeutet mehr FPS, Screenshots und manuelle Aufnahmen gehen weiter." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkGameDvr" Grid.Column="1" VerticalAlignment="Center" Checked="ChkGameDvr_Changed" Unchecked="ChkGameDvr_Changed"/>
                                    </Grid>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Mausbeschleunigung" Foreground="White" FontWeight="SemiBold"/>
                                            <TextBlock Text="Für Shooter besser aus: Die gleiche Handbewegung ergibt immer die gleiche Strecke auf dem Bildschirm." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkMouseAccel" Grid.Column="1" VerticalAlignment="Center" Checked="ChkMouseAccel_Changed" Unchecked="ChkMouseAccel_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="🖥  Grafiktreiber" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtDriverInfo" Foreground="#34D399" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="Neue Treiber bringen oft mehr FPS und beheben Abstürze in neuen Spielen."
                                           Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <WrapPanel>
                                        <Button Content="Treiber-Seite öffnen" Margin="0,0,8,8" Background="{DynamicResource AccentBrush}" Click="BtnOpenDriverPage_Click"/>
                                        <Button Content="Geräte-Manager" Margin="0,0,0,8" Tag="devmgmt.msc" Click="BtnOpenSetting_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Autostart -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="🚀  Autostart-Programme" Style="{StaticResource SectionTitle}"/>
                                    <Button Content="Task-Manager" Tag="taskmgr.exe" Click="BtnOpenSetting_Click" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="Programme, die mit Windows starten. Abwählen verhindert den Start (nur für deinen Benutzer)."
                                       Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <StackPanel x:Name="AutostartPanel"/>
