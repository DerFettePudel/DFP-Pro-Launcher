                                            <TextBlock Text="Kleine Einblendungen unten rechts, zum Beispiel bei neuen Spielen, Erfolgen oder Erinnerungen." Style="{StaticResource SubtleText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkToasts" Grid.Column="1" VerticalAlignment="Center" Checked="Option_Changed" Unchecked="Option_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
