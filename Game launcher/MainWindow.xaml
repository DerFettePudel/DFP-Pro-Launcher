                </Grid>
            </Border>

            <!-- ========== SCHWEBENDE LEISTE UNTEN (Seitenleiste „Unten“) ========== -->
            <Border x:Name="NavDock" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="10,6"
                CornerRadius="26" Background="{DynamicResource SidebarBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                    <StackPanel x:Name="NavDockPanel" Orientation="Horizontal">
                        <Border x:Name="NavDockDivider" Width="1" Height="34" Margin="8,0" Background="#33FFFFFF" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel x:Name="NavDockExtras" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Border x:Name="DockStreamBadge" Visibility="Collapsed" Margin="8,0,4,0" Padding="10,6" CornerRadius="14" Background="#33DC2626"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip="Streamer-Modus ist an. Klicken zum Ausschalten" MouseLeftButtonUp="StreamBadge_Click">
                            <TextBlock Text="📡" FontFamily="Segoe UI Emoji" FontSize="16"/>
                        </Border>
                    </StackPanel>
                </Viewbox>
            </Border>
        </Grid>

        <TextBlock Text="DFP PRO LAUNCHER" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,9"
               FontSize="10" FontWeight="SemiBold" Foreground="#40FFFFFF" IsHitTestVisible="False" Panel.ZIndex="5"/>

        <!-- ========== EIGENE FENSTERLEISTE (transparent) ========== -->
        <Grid x:Name="TitleBar" Height="34" VerticalAlignment="Top" Panel.ZIndex="45" Background="Transparent">
            <Border HorizontalAlignment="Right" Background="#8C000000" CornerRadius="0,0,0,12" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnWinMin" Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimieren" Click="BtnWinMin_Click"/>
                    <Button x:Name="BtnWinMax" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="Maximieren" Click="BtnWinMax_Click"/>
                    <Button x:Name="BtnWinClose" Style="{StaticResource CaptionCloseStyle}" Content="&#xE8BB;" ToolTip="Schließen" Click="BtnWinClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="ConfettiLayer" IsHitTestVisible="False" Panel.ZIndex="50"/>
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Panel.ZIndex="160"/>

        <!-- ========== SPOTLIGHT-SUCHE (Strg+K) ========== -->
        <Grid x:Name="SpotlightLayer" Visibility="Collapsed" Panel.ZIndex="100" Background="#B0000000"
          MouseLeftButtonDown="Spotlight_BackgroundClick">
            <Border Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,110,0,0"
                Style="{StaticResource CardStyle}" Padding="16" MouseLeftButtonDown="Spotlight_CardClick">
                <StackPanel>
                    <TextBox x:Name="TxtSpotlight" Height="48" FontSize="16"
                         TextChanged="TxtSpotlight_TextChanged" PreviewKeyDown="TxtSpotlight_PreviewKeyDown"/>
                    <StackPanel x:Name="SpotlightResults" Margin="0,10,0,0"/>
                    <TextBlock Text="↑ ↓ auswählen   ·   Enter öffnen   ·   Esc schließen" Foreground="#6B7280" FontSize="11" Margin="6,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== WILLKOMMENSANIMATION ========== -->
        <Grid x:Name="WelcomeLayer" Visibility="Collapsed" Panel.ZIndex="200" Cursor="Hand"
          Background="{DynamicResource AppBackgroundBrush}" MouseLeftButtonDown="WelcomeLayer_Click">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentControl x:Name="WelcomeLogo" Content="{StaticResource DfpLogo}" Width="124" Height="124" Opacity="0"
                            RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                    <ContentControl.RenderTransform>
                        <ScaleTransform x:Name="WelcomeLogoScale" ScaleX="0.6" ScaleY="0.6"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
                <TextBlock x:Name="WelcomeGreeting" FontSize="20" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,28,0,0" Opacity="0"/>
                <TextBlock x:Name="WelcomeName" FontSize="44" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="WelcomeNameShift" Y="16"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <Border x:Name="WelcomeLine" Width="0" Height="3" CornerRadius="2" Margin="0,18,0,0" HorizontalAlignment="Center"
                    Background="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>