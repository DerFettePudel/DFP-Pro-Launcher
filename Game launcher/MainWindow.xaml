                            <Border x:Name="ProfilesCard" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Tag="general">
                                <StackPanel>
                                    <TextBlock Text="Einstellungs-Profile" Style="{StaticResource SectionTitle}"/>
