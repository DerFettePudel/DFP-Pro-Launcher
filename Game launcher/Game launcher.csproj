<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>DFP_Pro_Launcher.ico</ApplicationIcon>
		<AssemblyName>DFPProLauncher</AssemblyName>
		<Product>DFP Pro Launcher</Product>
		<Authors>Der_Fette_Pudel</Authors>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="DFP_Pro_Launcher.ico" />
	</ItemGroup>

	<!-- Thema 2 „Cyber“: wird beim Start als Text gelesen (Akzentfarbe eingesetzt) und nicht als normale WPF-Seite übersetzt -->
	<ItemGroup>
		<Page Remove="Themes\Cyber.xaml" />
		<EmbeddedResource Include="Themes\Cyber.xaml" LogicalName="Game_launcher.Themes.Cyber.xaml" />
	</ItemGroup>

	<!-- Weitere Sprachen (Türkisch, Italienisch ...): je eine Datei "Kennung || Übersetzung", gelesen in Localization.cs -->
	<ItemGroup>
		<EmbeddedResource Include="Sprachen\*.txt" LogicalName="Game_launcher.Sprachen.%(Filename).txt" />
	</ItemGroup>

	<!-- Schrift „Chakra Petch“ für Überschriften in Thema 2 (SIL Open Font License 1.1, Lizenz liegt bei) -->
	<ItemGroup>
		<Resource Include="Fonts\*.ttf" />
		<Content Include="Fonts\OFL.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Lizenzen\ChakraPetch-OFL.txt</Link>
		</Content>
	</ItemGroup>

	<!-- Der GitHub-Workflow setzt UpdateRepository (Benutzer/Repository). Lokale Testversionen suchen deshalb keine Updates. -->
	<ItemGroup Condition="'$(UpdateRepository)' != ''">
		<AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.*" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
		<PackageReference Include="System.Management" Version="10.0.2" />
	</ItemGroup>

</Project>
